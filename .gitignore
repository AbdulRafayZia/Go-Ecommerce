vendor/

# Go workspace file
go.work.sum

# Environment variables
.env
.env.local
.env.*.local

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled Object files
*.o
*.a

# Profiling data
*.prof
*.pprof

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# Build artifacts
*.tar.gz
*.zip

# Database files
*.db
*.sqlite
*.sqlite3

# Generated proto files (comment out if you want to commit them)
# **/*.pb.go
# **/*_grpc.pb.go

# Buf lock file (will be regenerated)
proto/.buf.lock

